# Copy to ".env" (gitignored) and fill in real values, then: chmod 600 .env
# The daily/weekly scripts source this file so cron jobs see the secrets.
# Leave a line out entirely to skip that feature.

# Alert channel for the scheduled pipeline: file (default) | console | webhook | telegram
PEPTIDE_WATCH_CHANNEL=file

# --- Telegram (recommended if you already use a TG bot) ---
# Create a bot via @BotFather (/newbot) to get the token; get your chat id by
# messaging the bot then visiting api.telegram.org/bot<TOKEN>/getUpdates.
# PEPTIDE_WATCH_TELEGRAM_TOKEN=123456:ABC-DEF...
# PEPTIDE_WATCH_TELEGRAM_CHAT_ID=123456789

# --- Discord/Slack webhook (alternative) ---
# The whole URL is a secret (it contains a token).
# PEPTIDE_WATCH_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# PEPTIDE_WATCH_WEBHOOK_FIELD=content   # "content" for Discord, "text" for Slack

# Free key from https://api.data.gov/signup/ — enables reliable Regulations.gov
# scanning (without it the public DEMO_KEY rate-limits and throws 429).
# PEPTIDE_WATCH_REGULATIONS_API_KEY=your-data-gov-key

# Free key from https://developer.uspto.gov — enables the uspto_patents family.
# PEPTIDE_WATCH_USPTO_API_KEY=your-uspto-key

# SEC asks API users for a contact string as the User-Agent.
# PEPTIDE_WATCH_SEC_USER_AGENT=peptide-watch your-email@example.com
